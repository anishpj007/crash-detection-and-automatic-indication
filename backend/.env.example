# Optional persistent JWT signing key. Leave blank to generate a fresh key at startup.
CRASH_APP_SECRET=

# SMS notifications are sent only for incidents from a live detection session.
SMS_ENABLED=false
SMS_PROVIDER=twilio
# Keep true on a Twilio trial account; it sends a generic predefined alert.
# Set false only after upgrading if you want incident details in each SMS.
TWILIO_TRIAL_MODE=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_TO_NUMBER=

# Optional alternative: use an Android phone running SMS Gateway for Android
# on the same Wi-Fi as Flask. Keep SMS_PROVIDER=twilio to leave Twilio active;
# set SMS_PROVIDER=android_gateway only after the phone's Local Server is ready.
ANDROID_SMS_GATEWAY_URL
ANDROID_SMS_GATEWAY_USERNAME=
ANDROID_SMS_GATEWAY_PASSWORD=
